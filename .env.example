# Copy to .env and fill in. .env is git-ignored. See docs/ARCHITECTURE.md.

# --- LLM providers (dual provider with active fallback) ---
# Order is config-driven: dev = Ollama primary / Gemini fallback; on a cloud
# Space set PRIMARY_PROVIDER=gemini to invert it without a code change.
PRIMARY_PROVIDER=ollama
FALLBACK_PROVIDER=gemini

# Cloud provider (e.g. Google Gemini)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.0-flash
# Local provider (Ollama) — base URL of a running Ollama server + model name.
# OLLAMA_MODEL=auto → hardware-aware selection (ADR-010): pick the best local
# model that fits the detected RAM/VRAM at startup. Run `python -m src.core.hardware`
# to see the pick for this machine. Pin a concrete tag to override.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=auto

# --- Data ---
LEDGER_PATH=data/ledger.duckdb
# Hard cap on rows the SQL tool may return
MAX_ROWS=200

# --- Semantic plan-cache (ADR-009) ---
# Reuse a semantically-similar past question's *plan* (validated tool calls),
# re-executed live so the number is never stale. A miss falls through to the LLM.
PLAN_CACHE_ENABLED=true
# Cosine similarity a question must reach to reuse a cached plan (high on purpose).
PLAN_CACHE_THRESHOLD=0.90

# --- API auth ---
# Key required by the FastAPI service (sent as the X-API-Key request header).
# docker-compose bakes this same value into the web build (VITE_API_KEY) so the
# same-origin UI can authenticate — keep them equal.
APP_API_KEY=change-me
