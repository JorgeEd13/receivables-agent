# Copy to .env and fill in. .env is git-ignored. See docs/ARCHITECTURE.md.

# --- LLM providers (dual provider with active fallback) ---
# Order is config-driven: dev = Ollama primary / Gemini fallback; on a cloud
# Space set PRIMARY_PROVIDER=gemini to invert it without a code change.
PRIMARY_PROVIDER=ollama
FALLBACK_PROVIDER=gemini

# Cloud provider (e.g. Google Gemini)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.0-flash
# Local provider (Ollama) — base URL of a running Ollama server + model name
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Data ---
LEDGER_PATH=data/ledger.duckdb
# Hard cap on rows the SQL tool may return
MAX_ROWS=200

# --- API auth ---
# Key required by the FastAPI service (sent as a request header)
APP_API_KEY=change-me
