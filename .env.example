# Copy to .env and fill in. .env is git-ignored. See docs/ARCHITECTURE.md.

# --- LLM providers (dual provider with active fallback) ---
# Cloud provider (e.g. Google Gemini)
GEMINI_API_KEY=your-key-here
# Local provider (Ollama) — base URL of a running Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# --- API auth ---
# Key required by the FastAPI service (sent as a request header)
APP_API_KEY=change-me
